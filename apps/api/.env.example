# Sunucu
PORT=3001
NODE_ENV=development

# Veritabanı
DATABASE_URL=postgresql://KULLANICI:SIFRE@localhost:5432/taplink_dev

# CORS — frontend'in çalıştığı adres
CORS_ORIGIN=http://localhost:3000

# Better Auth
# BETTER_AUTH_SECRET üret: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3001

# Google OAuth (Cloud Console → Credentials → OAuth 2.0 Client ID)
# Authorized redirect URI: http://localhost:3001/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Apple OAuth (şimdilik boş — mobile app gelince doldurulacak)
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=

# Upstash Redis (rate limiting + cache + analytics buffer) — REST API bölümünden
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Mailjet (email doğrulama ve şifre sıfırlama) — Account settings → API Key Management
MAILJET_API_KEY=
MAILJET_SECRET_KEY=
MAILJET_FROM_EMAIL=noreply@taplink.my
MAILJET_FROM_NAME=Taplink.my

# Email linkleri için frontend adresi
FRONTEND_URL=http://localhost:3000

# Rate limiting — SADECE geliştirmede true yapılabilir (prod'da ASLA)
# true = tüm rate limitler devre dışı (curl testinde 429 yememek için)
DISABLE_RATE_LIMIT=

# Cloudflare R2 (görsel depolama)
# R2 → Object Storage → bucket + Account API Token (Object Read & Write)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=taplink-assets
# Public URL: bucket Settings → Public Development URL (pub-xxx.r2.dev) veya custom domain
R2_PUBLIC_URL=

# Stripe (test modu — Developers → API keys)
STRIPE_SECRET_KEY=
# Webhook secret: local test için `stripe listen` çıktısındaki whsec_...
STRIPE_WEBHOOK_SECRET=
# Products → ürün oluştur (Recurring/Monthly) → price_...
STRIPE_PRO_MONTHLY_PRICE_ID=
STRIPE_PRO_YEARLY_PRICE_ID=
